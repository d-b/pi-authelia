{
  "name": "@d-b/pi-authelia",
  "version": "1.2.0",
  "description": "Pi provider extension: Authelia device-authorization login (browser password + TOTP, CLI polls to completion) for a self-hosted OpenAI-compatible gateway, with optional upstream gateway-key attribution.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "authelia",
    "oidc",
    "oauth2",
    "device-flow",
    "rfc8628",
    "totp",
    "mfa",
    "llm-gateway"
  ],
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d-b/pi-authelia.git"
  },
  "homepage": "https://github.com/d-b/pi-authelia#readme",
  "bugs": {
    "url": "https://github.com/d-b/pi-authelia/issues"
  },
  "files": [
    "extensions",
    "CHANGELOG.md",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/*.ts"
    ],
    "changelogPath": "./CHANGELOG.md"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
